<view class="page">
  <view class="hero">
    <view class="title neon-title neon-flicker">冰箱剩菜盲盒</view>
    <view class="subtitle">深夜食堂主厨 · 在线整活</view>
    <view class="magic-wrap">
      <button class="magic-btn" hover-class="magic-btn-hover" bindtap="onGoCreate">
        <text class="magic-emoji">🎲</text>
        <text class="magic-text">开启魔法</text>
      </button>
      <view class="shake-tip">📳 摇一摇手机也能进入</view>
    </view>
  </view>

  <view class="rank-section">
    <view class="rank-title">🔥 黑暗料理红黑榜</view>
    <scroll-view class="rank-scroll" scroll-x enable-flex>
      <view class="rank-item panel" wx:for="{{list}}" wx:key="id">
        <view class="rank-emoji">{{item.emoji}}</view>
        <view class="rank-dish">{{item.dish}}</view>
        <view class="rank-comment">{{item.comment}}</view>
        <view class="rank-tag {{item.rating === '已进医院' ? 'tag-bad' : 'tag-good'}}">{{item.rating}}</view>
      </view>
    </scroll-view>
  </view>
</view>
