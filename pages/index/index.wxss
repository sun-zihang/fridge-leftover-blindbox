/* pages/index/index.wxss */
.page {
  min-height: 100vh;
  padding: 40rpx 30rpx;
  display: flex;
  flex-direction: column;
}

.hero {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0 40rpx;
}

.title {
  font-size: 72rpx;
  font-weight: 900;
}

.subtitle {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #8ea2c8;
  letter-spacing: 4rpx;
}

.magic-wrap {
  margin-top: 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.magic-btn {
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 30% 30%, #00f0ff, #b026ff 70%, #6a1fff);
  color: #ffffff;
  font-weight: 800;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 6rpx solid rgba(255, 255, 255, 0.35);
  box-shadow:
    0 0 30rpx rgba(0, 240, 255, 0.6),
    0 0 80rpx rgba(176, 38, 255, 0.4),
    inset 0 0 30rpx rgba(255, 255, 255, 0.15);
  animation: magicPulse 2s infinite;
  padding: 0;
}

.magic-btn::after {
  border: none;
}

.magic-btn-hover {
  transform: scale(0.94);
}

.magic-emoji {
  font-size: 88rpx;
  line-height: 1;
}

.magic-text {
  margin-top: 12rpx;
  font-size: 40rpx;
  letter-spacing: 6rpx;
}

@keyframes magicPulse {
  0%, 100% {
    box-shadow: 0 0 30rpx rgba(0, 240, 255, 0.6), 0 0 80rpx rgba(176, 38, 255, 0.4);
  }
  50% {
    box-shadow: 0 0 50rpx rgba(0, 240, 255, 0.9), 0 0 120rpx rgba(176, 38, 255, 0.7);
  }
}

.shake-tip {
  margin-top: 40rpx;
  color: #6b7f9e;
  font-size: 24rpx;
}

.rank-section {
  margin-top: 20rpx;
  padding-bottom: 40rpx;
}

.rank-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #ffe600;
  margin-bottom: 20rpx;
}

.rank-scroll {
  white-space: nowrap;
}

.rank-item {
  display: inline-block;
  width: 300rpx;
  margin-right: 20rpx;
  padding: 24rpx;
  vertical-align: top;
  white-space: normal;
}

.rank-emoji {
  font-size: 56rpx;
}

.rank-dish {
  margin-top: 12rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #00f0ff;
}

.rank-comment {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #9db1d4;
  height: 100rpx;
  overflow: hidden;
}

.rank-tag {
  display: inline-block;
  margin-top: 14rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.tag-good {
  background: rgba(0, 240, 160, 0.15);
  color: #00f0a0;
  border: 1rpx solid rgba(0, 240, 160, 0.4);
}

.tag-bad {
  background: rgba(255, 45, 120, 0.15);
  color: #ff2d78;
  border: 1rpx solid rgba(255, 45, 120, 0.4);
}
