/* pages/poster/poster.wxss */
.poster-page {
  min-height: 100vh;
  background: #0a0e1a;
}

.poster-scroll {
  height: 100vh;
}

.canvas-wrap {
  display: flex;
  justify-content: center;
  padding: 30rpx 30rpx 0;
}

.poster-canvas {
  border-radius: 16rpx;
  box-shadow: 0 0 40rpx rgba(0, 240, 255, 0.25);
}

.actions {
  display: flex;
  gap: 24rpx;
  padding: 30rpx;
}

.action-btn {
  flex: 1;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 16rpx;
}

.action-btn::after {
  border: none;
}

.save-btn {
  background: linear-gradient(135deg, #00f0ff, #b026ff);
  color: #ffffff;
}

.share-btn {
  background: rgba(255, 255, 255, 0.08);
  color: #00f0ff;
  border: 1rpx solid rgba(0, 240, 255, 0.4);
}

.tip {
  text-align: center;
  color: #6b7f9e;
  font-size: 24rpx;
  padding-bottom: 40rpx;
}
