page { background: #0a0e1a; color: #e6f7ff; }
.page { padding: 24rpx; }
.skin-label { text-align: center; color: #ffe600; font-size: 16px; font-weight: 700; margin-bottom: 16rpx; }
.poster-canvas { width: 100%; height: 1123rpx; background: #0d1230; border-radius: 14rpx; box-shadow: 0 0 40rpx rgba(0,240,255,.25); }
.save-btn { margin-top: 24rpx; background: linear-gradient(135deg,#00f0ff,#b026ff); color: #fff; font-weight: 800; border-radius: 14rpx; }
.share-btn { margin-top: 12rpx; background: rgba(255,255,255,.08); color: #00f0ff; border: 1rpx solid rgba(0,240,255,.4); border-radius: 14rpx; }
.tip { margin-top: 16rpx; text-align: center; color: #6b7f9e; font-size: 13px; }


/* ===== 设备自适应 ===== */
.page { padding-bottom: calc(60rpx + env(safe-area-inset-bottom)); }
.save-btn, .share-btn { min-height: 44px; }

@media (min-width: 768px) { .poster-canvas { max-width: 560px; margin: 0 auto; display: block; } }
