<view class="page">
  <view class="hero">
    <view class="hero-emoji">🍲🧄🥬🍅</view>
    <view class="title neon">冰箱剩菜盲盒</view>
    <view class="subtitle">深夜食堂主厨 · 在线整活</view>
    <button class="guide-btn" bindtap="openGuide" hover-class="btn-hover">❓ 怎么玩</button>
  </view>

  <!-- 生存挑战卡 -->
  <view class="challenge-card" wx:if="{{player}}">
    <view class="challenge-stats">
      <view class="stat"><text class="stat-icon">🔥</text><text class="stat-num">{{player.streak}}</text><text class="stat-label">连续天数</text></view>
      <view class="stat"><text class="stat-icon">🪙</text><text class="stat-num">{{player.points}}</text><text class="stat-label">生存积分</text></view>
      <view class="stat"><text class="stat-icon">🏅</text><text class="stat-num">{{player.badges.length}}</text><text class="stat-label">徽章</text></view>
    </view>
    <view class="badge-wall">
      <view class="badge-chip {{player.badges.indexOf(item.id) >= 0 ? '' : 'locked'}}" wx:for="{{badges}}" wx:key="id">{{item.emoji}} {{item.id}}</view>
    </view>
  </view>

  <!-- 输入 -->
  <view class="input-card">
    <textarea class="input-area" maxlength="200" placeholder="例如：半个洋葱、两包泡面、一瓶可乐" value="{{ingredients}}" bindinput="onInput"></textarea>
    <view class="input-footer">
      <button class="mic-btn" wx:if="{{micReady}}" bindtap="toggleMic" size="mini">{{micOn ? '🔊 结束' : '🎙️ 语音'}}</button>
      <text class="mic-hint" wx:if="{{micText}}">{{micText}}</text>
      <text class="char-count">{{charCount}}</text>
    </view>
  </view>

  <!-- 风格选择 -->
  <view class="style-row">
    <text class="style-label">主厨风格</text>
    <scroll-view scroll-x class="style-scroll">
      <view class="style-list">
        <view class="style-chip {{item.id === styleId ? 'selected' : ''}} {{item.unlocked ? '' : 'locked'}}" wx:for="{{styles}}" wx:key="id" data-id="{{item.id}}" bindtap="selectStyle" hover-class="tap-hover">{{item.name}}{{item.unlocked ? '' : ' 🔒' + item.cost}}</view>
      </view>
    </scroll-view>
  </view>

  <!-- 菜谱口味模式 -->
  <view class="mode-row">
    <text class="mode-label">菜谱口味</text>
    <view class="mode-switch">
      <view class="mode-btn {{mode === 'weird' ? 'active' : ''}}" data-mode="weird" bindtap="selectMode">🤪 猎奇整活</view>
      <view class="mode-btn {{mode === 'normal' ? 'active' : ''}}" data-mode="normal" bindtap="selectMode">🍚 正常家常</view>
    </view>
  </view>

  <button class="generate-btn" bindtap="onGenerate" hover-class="btn-hover">召唤主厨 👨‍🍳</button>

  <!-- 召唤主厨后的烹饪小剧场 -->
  <view class="pot-overlay" wx:if="{{generating}}">
    <view class="pot-scene">
      <view class="glow"></view>
      <view class="fire">🔥</view>
      <view class="fly-emoji" wx:for="{{flyEmojis}}" wx:key="index" style="left:{{item.left}}rpx; animation-delay:{{item.delay}}ms; animation-duration:{{item.dur}}ms; font-size:{{item.size}}rpx;">{{item.emoji}}</view>
      <view class="pot">🍲</view>
      <view class="ing i1">🥔</view>
      <view class="ing i2">🌽</view>
      <view class="ing i3">🥕</view>
      <view class="ing i4">🍜</view>
      <view class="bubble b1"></view>
      <view class="bubble b2"></view>
      <view class="bubble b3"></view>
      <view class="steam s1"></view>
      <view class="steam s2"></view>
    </view>
    <view class="pot-text">{{potText}}</view>
  </view>


  <!-- 剩菜博物馆 -->
  <view class="rank-section">
    <view class="rank-title">🏛️ 剩菜博物馆</view>
    <view class="rank-sub">全网最离谱菜谱大赏 · 按症状分类</view>
    <scroll-view scroll-x class="rank-tabs">
      <view class="rank-tab {{item === rankTag ? 'active' : ''}}" wx:for="{{rankTabs}}" wx:key="*this" data-tag="{{item}}" bindtap="onRankTab" hover-class="tap-hover">{{item}}</view>
    </scroll-view>
    <scroll-view scroll-x class="rank-scroll" enhanced show-scrollbar="{{false}}">
      <view class="rank-item" wx:for="{{rankData}}" wx:key="index" data-index="{{index}}" bindtap="onRankTap" hover-class="tap-hover">
        <view class="rank-emoji">{{item.rating === '已进医院' ? '🚑' : '😋'}}</view>
        <view class="rank-dish">{{item.name}}</view>
        <view class="rank-comment">{{item.warning}}</view>
        <view class="rank-foot">
          <text class="rank-tag {{item.rating === '已进医院' ? 'tag-bad' : 'tag-good'}}">{{item.rating}}</text>
          <text class="rank-tag-mini">{{item.tag}}</text>
        </view>
      </view>
    </scroll-view>
    <view class="rank-empty" wx:if="{{rankData.length === 0}}">还没有战报，来整活第一道菜吧 🍳</view>
  </view>

  <!-- 玩法速览弹层 -->
  <view class="guide-modal" wx:if="{{showGuide}}" bindtap="closeGuide">
    <view class="guide-card" catchtap="noop">
      <view class="guide-head">
        <text class="guide-title">🎉 玩法速览</text>
        <text class="guide-close" catchtap="closeGuide">✕</text>
      </view>
      <scroll-view scroll-y class="guide-scroll">
        <view class="guide-step"><text class="gs-num">1</text><view class="gs-body"><text class="gs-title">报菜名</text><text class="gs-desc">说出你的剩菜（洋葱、泡面、可乐？越离谱越好）</text></view></view>
        <view class="guide-step"><text class="gs-num">2</text><view class="gs-body"><text class="gs-title">召唤主厨</text><text class="gs-desc">AI 主厨现场整活：食材满天飞、文案现场编</text></view></view>
        <view class="guide-step"><text class="gs-num">3</text><view class="gs-body"><text class="gs-title">开盲盒</text><text class="gs-desc">菜名、做法、摆盘、主厨警告一层层揭晓</text></view></view>
        <view class="guide-step"><text class="gs-num">4</text><view class="gs-body"><text class="gs-title">下结论</text><text class="gs-desc">「真香 😋」还是「已进医院 🚑」，结局你说了算</text></view></view>
        <view class="guide-tags">
          <text>🏅 连续7天打卡 → 暗黑料理大师</text>
          <text>🪙 作死积分解锁限定人设</text>
          <text>🏆 米其林认证书 / 急诊挂号单</text>
          <text>🔥 甩锅给好友，双倍积分</text>
          <text>🏛️ 剩菜博物馆：按症状分类</text>
        </view>
      </scroll-view>
    </view>
  </view>

  <view class="footer">Powered by 腾讯云开发 CloudBase · AI 深夜食堂</view>
</view>
