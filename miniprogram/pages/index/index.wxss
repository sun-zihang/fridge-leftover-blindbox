/* 冰箱剩菜盲盒 · 小程序版（移植网页版风格） */
page { background: #0a0e1a; color: #e6f7ff; font-size: 15px; }
.page { padding: 24rpx 24rpx 60rpx; }
.hero { text-align: center; padding: 30rpx 0 24rpx; }
.title { font-size: 44px; font-weight: 900; letter-spacing: 6rpx; color: #00f0ff; text-shadow: 0 0 12px rgba(0,240,255,.9); }
.subtitle { margin-top: 8rpx; color: #8ea2c8; letter-spacing: 3rpx; }
.challenge-card { margin-top: 20rpx; background: linear-gradient(160deg, rgba(20,28,56,.85), rgba(10,18,40,.9)); border: 2rpx solid rgba(255,230,0,.35); border-radius: 16rpx; padding: 16rpx; }
.challenge-stats { display: flex; }
.stat { flex: 1; text-align: center; background: rgba(255,255,255,.04); border-radius: 12rpx; padding: 10rpx 4rpx; }
.stat-icon { font-size: 20px; display: block; }
.stat-num { display: block; font-size: 20px; color: #ffe600; font-weight: 800; }
.stat-label { font-size: 11px; color: #8ea2c8; }
.badge-wall { margin-top: 12rpx; display: flex; flex-wrap: wrap; }
.badge-chip { padding: 2rpx 14rpx; border-radius: 999rpx; font-size: 12px; margin: 4rpx; background: rgba(0,240,255,.12); color: #00f0ff; border: 1rpx solid rgba(0,240,255,.4); }
.badge-chip.locked { opacity: .4; filter: grayscale(1); }
.input-card { margin-top: 20rpx; background: rgba(20,28,56,.75); border: 2rpx solid rgba(0,240,255,.25); border-radius: 16rpx; padding: 16rpx; }
.input-area { width: 100%; min-height: 120rpx; color: #e6f7ff; font-size: 16px; }
.input-footer { display: flex; align-items: center; }
.mic-btn { background: rgba(0,240,255,.12); color: #00f0ff; border: 1rpx solid rgba(0,240,255,.4); font-size: 13px; }
.mic-hint { color: #ff2d78; font-size: 12px; margin-left: 12rpx; }
.char-count { margin-left: auto; color: #5b6c8c; font-size: 13px; }
.style-row { margin-top: 16rpx; display: flex; align-items: center; }
.style-label { color: #8ea2c8; font-size: 13px; margin-right: 12rpx; flex-shrink: 0; }
.style-scroll { flex: 1; white-space: nowrap; height: 88rpx; overflow: hidden; }
.style-list { display: inline-flex; align-items: center; height: 100%; }
.style-chip { display: inline-block; padding: 6rpx 20rpx; border-radius: 999rpx; font-size: 13px; margin-right: 10rpx; background: rgba(255,255,255,.05); color: #9db1d4; border: 1rpx solid rgba(255,255,255,.15); }
.style-chip.selected { background: linear-gradient(135deg,#00f0ff,#b026ff); color: #0a0e1a; font-weight: 800; border-color: transparent; }
.style-chip.locked { opacity: .55; }
.generate-btn { margin-top: 22rpx; background: linear-gradient(135deg,#00f0ff,#b026ff); color: #fff; font-size: 17px; font-weight: 800; letter-spacing: 3rpx; border-radius: 14rpx; }
.rank-section { margin-top: 40rpx; }
.rank-title { font-size: 20px; font-weight: 800; color: #ffe600; }
.rank-sub { margin-top: 4rpx; color: #5b6c8c; font-size: 13px; }
.rank-tabs { margin-top: 14rpx; white-space: nowrap; height: 60rpx; overflow: hidden; }
.rank-tab { display: inline-block; height: 56rpx; line-height: 56rpx; padding: 0 20rpx; border-radius: 999rpx; font-size: 12px; margin-right: 10rpx; background: rgba(255,255,255,.05); color: #9db1d4; border: 1rpx solid rgba(255,255,255,.15); }
.rank-tab.active { background: rgba(255,230,0,.18); color: #ffe600; border-color: rgba(255,230,0,.5); font-weight: 700; }
.rank-scroll { margin-top: 14rpx; white-space: nowrap; height: 300rpx; overflow: hidden; }
.rank-item { display: inline-block; width: 300rpx; height: 100%; vertical-align: top; margin-right: 14rpx; padding: 14rpx; overflow: hidden; background: rgba(20,28,56,.75); border: 2rpx solid rgba(0,240,255,.25); border-radius: 14rpx; box-sizing: border-box; }
.rank-emoji { font-size: 30px; }
.rank-dish { margin-top: 6rpx; font-size: 16px; font-weight: 700; color: #00f0ff; }
.rank-comment { margin-top: 6rpx; font-size: 13px; color: #9db1d4; min-height: 60rpx; max-height: 96rpx; overflow: hidden; }
.rank-foot { margin-top: 10rpx; }
.rank-tag { padding: 2rpx 12rpx; border-radius: 999rpx; font-size: 12px; font-weight: 700; }
.tag-good { background: rgba(0,240,160,.15); color: #00f0a0; border: 1rpx solid rgba(0,240,160,.5); }
.tag-bad { background: rgba(255,45,120,.15); color: #ff2d78; border: 1rpx solid rgba(255,45,120,.5); }
.rank-tag-mini { margin-left: 10rpx; font-size: 10px; color: #9db1d4; }
.footer { margin-top: 50rpx; text-align: center; color: #4a5a78; font-size: 12px; }


/* ===== 设备自适应 ===== */
.page { padding-bottom: calc(60rpx + env(safe-area-inset-bottom)); }
.rank-dish, .rank-comment { word-break: break-all; }
.title { max-width: 100%; word-break: break-all; }
/* 小屏适配 */
@media screen and (max-width: 320px) {
  .title { font-size: 34px; }
  .generate-btn { font-size: 15px; }
  .rank-item { width: 260rpx; }
}
/* 触摸目标最小高度 */
.generate-btn, .style-chip, .rank-tab { min-height: 44px; }


/* ===== 召唤主厨后：烹饪小剧场 ===== */
.pot-overlay {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(5,8,18,.92);
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  z-index: 999;
}
.pot-scene { position: relative; width: 260rpx; height: 220rpx; }
.pot { font-size: 96rpx; animation: potShake .7s infinite; position: relative; z-index: 2; text-align: center; }
@keyframes potShake { 0%,100% { transform: rotate(-5deg); } 50% { transform: rotate(5deg); } }
.ing { position: absolute; font-size: 40rpx; z-index: 3; animation: ingBounce 1.1s ease-in-out infinite; }
.i1 { bottom: 60rpx; left: 20rpx; }
.i2 { bottom: 72rpx; left: 92rpx; animation-delay: .25s; }
.i3 { bottom: 52rpx; left: 160rpx; animation-delay: .5s; }
.i4 { bottom: 76rpx; left: 204rpx; animation-delay: .75s; }
@keyframes ingBounce {
  0%,100% { transform: translateY(0) rotate(-12deg); }
  50% { transform: translateY(-36rpx) rotate(14deg); }
}
.bubble { position: absolute; width: 16rpx; height: 16rpx; border-radius: 50%; background: rgba(0,240,255,.8); animation: bubbleUp 1.2s infinite; opacity: 0; }
.b1 { bottom: 30rpx; left: 90rpx; }
.b2 { bottom: 22rpx; left: 130rpx; width: 22rpx; height: 22rpx; animation-delay: .4s; }
.b3 { bottom: 14rpx; left: 170rpx; animation-delay: .8s; }
@keyframes bubbleUp {
  0% { transform: translateY(0) scale(.6); opacity: .9; }
  100% { transform: translateY(-140rpx) scale(1.2); opacity: 0; }
}
.steam { position: absolute; width: 14rpx; height: 34rpx; border-radius: 50%; background: rgba(255,255,255,.35); filter: blur(3px); animation: steamUp 1.6s infinite; opacity: 0; }
.s1 { bottom: 130rpx; left: 84rpx; }
.s2 { bottom: 136rpx; left: 150rpx; animation-delay: .8s; }
@keyframes steamUp {
  0% { transform: translateY(0) scale(.7); opacity: .7; }
  100% { transform: translateY(-56rpx) scale(1.3); opacity: 0; }
}
.pot-text { margin-top: 30rpx; color: #8ea2c8; font-size: 15px; text-align: center; padding: 0 40rpx; min-height: 44rpx; }


/* ===== 特效：火焰 / 光环 / 飞食材 ===== */
.glow {
  position: absolute; left: 50%; top: 50%;
  width: 300rpx; height: 300rpx;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255,230,0,.25), rgba(255,45,120,.08) 55%, transparent 70%);
  animation: glowPulse 1.6s ease-in-out infinite;
}
@keyframes glowPulse { 0%,100% { opacity: .6; transform: translate(-50%,-50%) scale(1); } 50% { opacity: 1; transform: translate(-50%,-50%) scale(1.12); } }
.fire {
  position: absolute; bottom: -14rpx; left: 50%;
  font-size: 56rpx; transform: translateX(-50%);
  animation: fireFlicker .45s ease-in-out infinite;
  z-index: 1;
}
@keyframes fireFlicker {
  0%,100% { transform: translateX(-50%) scale(1) rotate(-3deg); opacity: .9; }
  50% { transform: translateX(-50%) scale(1.15) rotate(3deg); opacity: 1; }
}
.fly-emoji {
  position: absolute; bottom: 40rpx; z-index: 4;
  animation: flyUp ease-in-out infinite;
  opacity: 0;
}
@keyframes flyUp {
  0% { transform: translateY(0) translateX(0) rotate(0deg) scale(.7); opacity: 0; }
  15% { opacity: 1; }
  50% { transform: translateY(-160rpx) translateX(24rpx) rotate(20deg) scale(1.1); }
  85% { opacity: 1; }
  100% { transform: translateY(-320rpx) translateX(-18rpx) rotate(-16deg) scale(.85); opacity: 0; }
}


/* ===== 玩法速览 ===== */
.guide-btn { display: inline-block; margin-top: 16rpx; padding: 6rpx 28rpx; font-size: 13px; color: #ffe600; background: rgba(255,230,0,.1); border: 1rpx solid rgba(255,230,0,.45); border-radius: 999rpx; line-height: 1.6; }
.guide-modal { position: fixed; left: 0; top: 0; right: 0; bottom: 0; background: rgba(5,8,18,.85); z-index: 998; display: flex; align-items: center; justify-content: center; padding: 40rpx; }
.guide-card { width: 100%; max-width: 640rpx; background: linear-gradient(160deg,#1b1038,#0d1230); border: 2rpx solid rgba(255,230,0,.4); border-radius: 24rpx; padding: 28rpx; box-shadow: 0 0 60rpx rgba(255,230,0,.15); }
.guide-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }
.guide-title { font-size: 20px; font-weight: 900; color: #ffe600; }
.guide-close { font-size: 28px; color: #8ea2c8; padding: 0 8rpx; }
.guide-scroll { max-height: 70vh; }
.guide-step { display: flex; align-items: flex-start; background: rgba(255,255,255,.04); border-radius: 14rpx; padding: 14rpx; margin-bottom: 12rpx; }
.gs-num { flex-shrink: 0; width: 40rpx; height: 40rpx; border-radius: 50%; background: linear-gradient(135deg,#00f0ff,#b026ff); color: #0a0e1a; font-weight: 900; text-align: center; line-height: 40rpx; margin-right: 14rpx; }
.gs-body { flex: 1; display: flex; flex-direction: column; }
.gs-title { color: #00f0ff; font-weight: 800; font-size: 15px; }
.gs-desc { color: #dceaff; font-size: 13px; margin-top: 4rpx; }
.guide-tags { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 6rpx; }
.guide-tags text { font-size: 12px; color: #ffe600; background: rgba(255,230,0,.08); border: 1rpx solid rgba(255,230,0,.35); border-radius: 999rpx; padding: 6rpx 16rpx; }
