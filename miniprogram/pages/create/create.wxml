<view class="page">
  <!-- 好友投喂横幅 -->
  <view class="challenge-banner" wx:if="{{challengeBanner}}">
    <text class="banner-emoji">🍽️</text>
    <view class="banner-text">
      <text class="banner-title">来自好友的投喂</text>
      <text class="banner-sub">TA 甩给你一道「黑暗料理」，接受后双方 +20 积分</text>
    </view>
    <button class="accept-btn" size="mini" bindtap="acceptChallenge" hover-class="btn-hover">接受挑战</button>
  </view>

  <!-- 结果 -->
  <view class="result" wx:if="{{recipe}}">
    <view class="dish-name neon">{{recipe.name}}</view>
    <view class="lib-badge" wx:if="{{recipe.lib}}">📖 家常菜谱库精选</view>
    <view class="points-line" wx:if="{{pointsLine}}">{{pointsLine}}</view>
    <view class="dish-ingredients" wx:if="{{ingredients}}">食材：{{ingredients}}</view>

    <view class="section-toggle" bindtap="toggleSteps" hover-class="tap-hover">
      <text>👨‍🍳 轻触查看做法</text><text class="chev {{stepsOpen ? 'open' : ''}}">▾</text>
    </view>
    <view class="collapsible" wx:if="{{stepsOpen}}">
      <view class="step-card" wx:for="{{recipe.steps}}" wx:key="index" data-index="{{index}}" bindtap="flipStep" hover-class="tap-hover">
        <view class="step-inner {{item.flipped ? 'flipped' : ''}}">
          <view class="step-face step-front">
            <text class="step-num">{{index + 1}}</text>
            <text class="step-emoji">{{stepEmojis[index % 6]}}</text>
            <text class="step-flip-hint">轻触翻面</text>
          </view>
          <view class="step-face step-back">{{item.text}}</view>
        </view>
      </view>
      <view class="flip-hint">👆 轻触卡片翻面查看步骤</view>
    </view>

    <view class="section-title">🍽️ 摆盘建议</view>
    <view class="plating">“{{recipe.plating}}”</view>

    <view class="section-toggle" bindtap="toggleWarning" hover-class="tap-hover">
      <text>⚠️ 轻触查看主厨警告</text><text class="chev {{warningOpen ? 'open' : ''}}">▾</text>
    </view>
    <view class="warning" wx:if="{{warningOpen}}">{{recipe.warning}}</view>

    <!-- 详细菜单制作界面（内置菜谱库） -->
    <view class="detail-toggle" wx:if="{{recipe.ings}}" bindtap="toggleDetail" hover-class="tap-hover">
      <text>📖 查看完整菜单</text><text class="chev {{detailOpen ? 'open' : ''}}">▾</text>
    </view>
    <view class="detail-panel" wx:if="{{detailOpen}}">
      <view class="detail-meta" wx:if="{{recipe.scene || recipe.time}}">
        <text wx:if="{{recipe.scene}}">{{recipe.scene}}</text>
        <text wx:if="{{recipe.time}}"> · ⏱️ 约 {{recipe.time}} 分钟</text>
      </view>
      <view class="detail-sec" wx:if="{{recipe.ings.length}}">
        <view class="detail-sec-title">🧺 食材清单</view>
        <view class="ing-item" wx:for="{{recipe.ings}}" wx:key="*this">{{item}}</view>
      </view>
      <view class="detail-sec" wx:if="{{recipe.prep.length}}">
        <view class="detail-sec-title">🔪 备菜准备</view>
        <view class="prep-item" wx:for="{{recipe.prep}}" wx:key="*this">• {{item}}</view>
      </view>
      <view class="detail-sec" wx:if="{{recipe.steps.length}}">
        <view class="detail-sec-title">👨‍🍳 分步做法</view>
        <view class="detail-step" wx:for="{{recipe.steps}}" wx:key="index">
          <text class="detail-step-num">{{index + 1}}</text>
          <text class="detail-step-text">{{item.text}}</text>
        </view>
      </view>
      <view class="detail-sec" wx:if="{{recipe.tips}}">
        <view class="detail-sec-title">💡 主厨小贴士</view>
        <view class="detail-tips">{{recipe.tips}}</view>
      </view>
    </view>

    <view class="rate-row">
      <text class="rate-title">这菜你觉得？</text>
      <button class="rate-btn good" size="mini" data-rating="真香" bindtap="rate" hover-class="tap-hover">真香 😋</button>
      <button class="rate-btn bad" size="mini" data-rating="已进医院" bindtap="rate" hover-class="tap-hover">已进医院 🚑</button>
    </view>

    <button class="poster-btn" bindtap="goPoster" hover-class="btn-hover">{{posterBtnText}}</button>
    <button class="challenge-btn" bindtap="makeChallenge" wx:if="{{recordId}}">🔥 甩锅给好友</button>
    <button class="share-btn" open-type="share" hover-class="btn-hover">分享给好友</button>
  </view>

  <view class="empty" wx:else>正在把菜端上来…</view>
</view>
